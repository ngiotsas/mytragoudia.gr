---
layout: base.njk
---
<section class="wrap page-head">
<p class="eyebrow"><a href="/lyrics/">Στίχοι</a> / {{ title }}</p>
<h1 class="song-title">{{ title }}</h1>
<p class="mono small muted">{% if subtitle %}{{ subtitle }} · {% endif %}Lyrics · {{ site.name }}</p>
</section>
<section class="wrap">
<div class="lyrics"{% if lang %} lang="{{ lang }}"{% endif %}>
{{ content | safe }}
</div>
{%- if audio %}
<div class="player" data-player>
<audio src="{{ audio }}" preload="metadata"></audio>
<button class="player-btn" type="button" aria-label="Αναπαραγωγή" data-play>
<svg class="i-play" viewBox="0 0 24 24" width="22" height="22" aria-hidden="true"><path d="M8 5.5v13l11-6.5z"/></svg>
<svg class="i-pause" viewBox="0 0 24 24" width="22" height="22" aria-hidden="true"><path d="M7 5h3.5v14H7zM13.5 5H17v14h-3.5z"/></svg>
</button>
<div class="player-main">
<span class="mono small">Άκου το τραγούδι</span>
<input class="player-seek" type="range" min="0" max="100" step="0.1" value="0" aria-label="Θέση" data-seek>
</div>
<span class="mono small player-time" data-time>0:00</span>
</div>
<script>
(function () {
  var box = document.querySelector("[data-player]"), a = box.querySelector("audio"),
      btn = box.querySelector("[data-play]"), seek = box.querySelector("[data-seek]"), time = box.querySelector("[data-time]");
  function fmt(s) { s = Math.floor(s || 0); return Math.floor(s / 60) + ":" + String(s % 60).padStart(2, "0"); }
  function show() {
    var d = a.duration || 0;
    seek.max = d || 100; seek.value = a.currentTime;
    seek.style.setProperty("--p", d ? (a.currentTime / d) * 100 + "%" : "0%");
    time.textContent = fmt(a.currentTime) + " / " + fmt(d);
  }
  btn.addEventListener("click", function () { a.paused ? a.play() : a.pause(); });
  a.addEventListener("play", function () { box.classList.add("is-playing"); btn.setAttribute("aria-label", "Παύση"); });
  a.addEventListener("pause", function () { box.classList.remove("is-playing"); btn.setAttribute("aria-label", "Αναπαραγωγή"); });
  a.addEventListener("timeupdate", show);
  a.addEventListener("loadedmetadata", show);
  a.addEventListener("ended", function () { a.currentTime = 0; show(); });
  seek.addEventListener("input", function () { a.currentTime = seek.value; show(); });
})();
</script>
{%- endif %}
<p class="back"><a href="/lyrics/">← Όλοι οι στίχοι</a></p>
</section>
