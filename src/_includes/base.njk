<!DOCTYPE html>
<html lang="el">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>{% if pageTitle %}{{ pageTitle }} | {{ site.name }}{% else %}{{ site.name }}{% endif %}</title>
<meta name="description" content="{{ description or site.tagline }}">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Fira+Sans+Extra+Condensed:wght@700;800&family=Commissioner:wght@400;500;600&family=Fira+Mono:wght@400;500&display=swap">
<link rel="stylesheet" href="/assets/style.css">
</head>
<body>
<header class="site-head"><div class="wrap head-row">
<a class="logo" href="/">MyTragoudia<span>.GR</span></a>
<nav aria-label="Κύρια πλοήγηση">
{%- for item in site.nav %}<a href="{{ item.url }}"{% if item.url | isActive(page.url) %} aria-current="page"{% endif %}>{{ item.label }}</a>{% endfor -%}
</nav></div></header>
<main>
{{ content | safe }}
</main>
<footer class="site-foot"><div class="wrap foot-row">
<p><strong>{{ site.name }}</strong><br>{{ site.tagline }}</p>
<nav aria-label="Υποσέλιδο">{% for item in site.nav %}<a href="{{ item.url }}">{{ item.label }}</a>{% endfor %}</nav>
<p class="mono small">© {% year %} mytragoudia.gr</p></div></footer>
</body>
</html>
